# Copy to .env and edit: cp .env.example .env

# Image version, matches jumpserver/jms_all:<VERSION>
VERSION=v5.3.0

# Published ports
HTTP_PORT=80
SSH_PORT=2222

# Required: at least 50 random alphanumeric characters, no special characters; must not change after the first deployment
SECRET_KEY=[API_KEY]

# Required: at least 24 random characters; keep it unchanged across restarts and upgrades
BOOTSTRAP_TOKEN=PleaseChangeMe

# Optional: override the AI delegation signing key derived from BOOTSTRAP_TOKEN, at least 32 characters
# CHAT_AI_DELEGATION_SECRET=

# Start the bundled AI service and enable its Web route
KAEL_ENABLED=1
LOG_LEVEL=INFO
